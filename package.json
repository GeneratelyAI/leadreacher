{
  "name": "leadreacher",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix packages/shared run build",
    "check:architecture": "node tools/architecture/audit.mjs --check",
    "test:architecture": "node --test tools/architecture/graph.test.mjs",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@leadreacher/web",
    "dev:api": "turbo dev --filter=@leadreacher/api",
    "dev:worker": "pnpm --filter @leadreacher/api dev:worker"
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  },
  "packageManager": "pnpm@9.15.9"
}
