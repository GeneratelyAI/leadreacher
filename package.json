{
  "name": "leadreacher",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@leadreacher/web",
    "dev:api": "turbo dev --filter=@leadreacher/api",
    "dev:worker": "pnpm --filter @leadreacher/api dev:worker"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0",
      "mysql2": "3.22.0"
    }
  },
  "packageManager": "pnpm@9.15.9"
}
