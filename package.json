{
  "name": "leadreacher",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix packages/shared run build",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@leadreacher/web",
    "dev:api": "turbo dev --filter=@leadreacher/api",
    "dev:worker": "pnpm --filter @leadreacher/api dev:worker"
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0",
      "fast-uri@^3": "3.1.8",
      "fast-uri@^4": "4.1.5",
      "brace-expansion@^5": "5.0.12",
      "ip-address": "10.7.1",
      "hono": "4.13.7",
      "mysql2": "3.23.1",
      "postcss": "8.5.23",
      "qs": "6.16.0"
    }
  },
  "packageManager": "pnpm@9.15.9"
}
