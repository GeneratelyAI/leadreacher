{
  "name": "@leadreacher/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && tsx watch src/index.ts",
    "dev:worker": "prisma generate && RUNTIME_ROLE=worker ENABLE_CAMPAIGN_WORKER=true tsx watch src/worker.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "tsx src/scripts/seed-demo-workspace.ts",
    "seed:messages": "tsx src/scripts/seed-messages-inbox-demo.ts",
    "video:benchmark": "tsx src/scripts/evaluate-video-providers.ts",
    "preflight:production": "tsx src/scripts/production-preflight.ts",
    "preflight:staging": "tsx src/scripts/staging-provider-canary.ts",
    "test:staging-safe-journeys": "tsx src/scripts/staging-safe-journeys.ts",
    "verify:release-canary": "tsx src/scripts/verify-release-canary.ts",
    "test:integration": "RUN_DATABASE_INTEGRATION=true vitest run src/integration",
    "migrate:unipile-v2": "tsx src/scripts/migrate-unipile-v2-accounts.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@aws-sdk/s3-request-presigner": "^3.1102.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/swagger": "^9.8.1",
    "@google/genai": "2.16.0",
    "@hono/node-server": "2.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@scalar/fastify-api-reference": "^1.63.0",
    "@sentry/node": "^10.69.0",
    "@supabase/supabase-js": "^2.107.0",
    "archiver": "^8.0.0",
    "bullmq": "5.78.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "fastify-plugin": "^6.0.0",
    "fastify-raw-body": "^5.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ffmpeg-static": "^5.3.0",
    "ioredis": "5.10.1",
    "pg": "^8.21.0",
    "resend": "^6.18.1",
    "sharp": "^0.35.3",
    "stripe": "^22.3.1",
    "undici": "^7.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.1",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
