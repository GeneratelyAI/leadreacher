# Server
PORT=3001
NODE_ENV=development
RUNTIME_ROLE=api

# Database (Supabase)
DATABASE_URL=
DIRECT_URL=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth (JWT verification for API requests)
SUPABASE_URL=

# CORS (comma-separated Next.js app origins)
CORS_ORIGIN=https://leadreacher.ai,https://www.leadreacher.ai

# Unipile
UNIPILE_DSN=
UNIPILE_API_KEY=

UNIPILE_WEBHOOK_SECRET=

# Webhook registration target (set one; UNIPILE_WEBHOOK_URL wins)
UNIPILE_WEBHOOK_URL=
PUBLIC_BASE_URL=

# Redis (provider-neutral)
# Railway: add a Redis service, then reference its REDIS_URL variable here.
# Local development: use redis://localhost:6379 with Docker or Homebrew Redis.
# REDIS_PASSWORD is only needed when the URL does not already include one.
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# API service: keep every worker flag false. Worker service: production requires
# every flag below to be true so readiness covers all background work families.
ENABLE_CAMPAIGN_WORKER=false
ENABLE_RECONCILE_WORKER=false
ENABLE_VIDEO_WORKER=false
ENABLE_ANALYTICS_INSIGHTS_WORKER=false
ENABLE_LIFECYCLE_WORKER=false
# Emergency rollback only: comma-separated worker families to pause while
# keeping the worker process and all campaign state intact.
PAUSED_WORKER_FAMILIES=
BULLMQ_IDLE_DRAIN_DELAY_SECONDS=60

# Better Stack worker heartbeats
BETTERSTACK_CAMPAIGN_WORKER_HEARTBEAT_URL=
BETTERSTACK_VIDEO_WORKER_HEARTBEAT_URL=
BETTERSTACK_RECONCILE_WORKER_HEARTBEAT_URL=

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Automated incident repair (disabled by default)
INCIDENT_AUTOFIX_ENABLED=false
INCIDENT_AUTOFIX_DRY_RUN=true
INCIDENT_AUTOFIX_AUTO_MERGE=false
ENABLE_INCIDENT_AUTOFIX_WORKER=false
# Client Secret from the Sentry internal integration. Sentry uses it to sign
# the JSON payload in the Sentry-Hook-Signature header.
SENTRY_WEBHOOK_SECRET=
SENTRY_API_TOKEN=
SENTRY_ORG_SLUG=
BETTERSTACK_WEBHOOK_SECRET=
BETTERSTACK_API_TOKEN=
INCIDENT_AUTOFIX_CALLBACK_SECRET=

# API docs (Scalar at /docs, OpenAPI at /documentation/json).
# Default: on when NODE_ENV !== production. Set false to disable locally.
ENABLE_API_DOCS=true

# Apify
APIFY_API_KEY=

# Groq
GROQ_API_KEY=

# Firecrawl
FIRECRAWL_API_KEY=

# Google AI Studio (Veo, Gemini Omni, and Gemini TTS)
GOOGLE_AI_API_KEY=
# Legacy Cloud TTS variable. Gemini TTS uses GOOGLE_AI_API_KEY instead.
GOOGLE_TTS_API_KEY=
PERSONALIZED_VIDEO_TTS_VOICE=Kore
VIDEO_GENERATION_PROVIDER=veo
VIDEO_MOCK_MODE=false
VEO_PARALLEL_VARIANTS=1

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Public MP4 used by the read-only production preflight range-playback check.
R2_PREFLIGHT_VIDEO_URL=

# Stripe
# Keep true for local/test: no Stripe API calls are made. Production must set false.
STRIPE_MOCK_MODE=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs. Prices and display amounts are configured in Stripe, never in code.
STRIPE_PRICE_PERSONALIZED_OUTREACH=
STRIPE_PRICE_AI_VIDEO_AD=
STRIPE_PRICE_UPLOADED_VIDEO=
STRIPE_PRICE_VIDEO_ADDON=

# Browser return URL for Stripe Checkout hosted redirects.
APP_URL=http://localhost:3000

# Product support and transactional email
# Keep this equal to the web service's NEXT_PUBLIC_SUPPORT_EMAIL.
SUPPORT_EMAIL=support@leadreacher.com
RESEND_API_KEY=
PRODUCT_EMAIL_FROM=LeadReacher <notifications@leadreacher.com>

# Versioned legal acceptance
TERMS_VERSION=2026-08-04
PRIVACY_VERSION=2026-08-04
LEGAL_ACCEPTANCE_REQUIRED=false
