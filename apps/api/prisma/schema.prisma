generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                   String                  @id @default(cuid())
  name                 String
  /// "individual" | "company"
  accountType          String                  @default("individual")
  supabaseOrgId        String                  @unique
  plan                 String                  @default("starter")
  onboardingData       Json?
  onboardedAt          DateTime?
  stripeCustomerId     String?                 @unique
  stripeSubscriptionId String?
  subscriptionStatus   String?
  planPriceId          String?
  currentPeriodEnd     DateTime?
  disabledAt           DateTime?
  deletionRequestedAt  DateTime?
  purgeAt              DateTime?
  legalAcceptedAt      DateTime?
  termsVersion         String?
  privacyVersion       String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  users                User[]
  integrations         Integration[]
  campaigns            Campaign[]
  leads                Lead[]
  strategies           Strategy[]
  socialAccounts       SocialAccount[]
  videoAssets          VideoAsset[]
  videoTemplates       CampaignVideoTemplate[]
  activityEvents       ActivityEvent[]
  emailOutbox          ProductEmailOutbox[]
  exportJobs           OrganizationExportJob[]
}

model ActivityEvent {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  eventType      String
  campaignId     String?
  leadId         String?
  messageId      String?
  channel        String?
  actorUserId    String?
  title          String
  detail         String
  metadata       Json?
  idempotencyKey String?      @unique
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([orgId, occurredAt, id])
  @@index([orgId, eventType, occurredAt])
  @@index([orgId, campaignId, occurredAt])
}

model ProductEmailOutbox {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  idempotencyKey String       @unique
  template       String
  recipient      String
  subject        String
  payload        Json
  status         String       @default("pending") // 'pending' | 'sending' | 'sent' | 'failed'
  attempts       Int          @default(0)
  scheduledAt    DateTime     @default(now())
  sentAt         DateTime?
  lastError      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, scheduledAt])
  @@index([orgId, createdAt])
}

model OrganizationExportJob {
  id            String       @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requestedById String
  format        String       @default("json") // 'json' | 'csv'
  status        String       @default("pending") // 'pending' | 'processing' | 'ready' | 'failed' | 'expired'
  objectKey     String?
  manifest      Json?
  expiresAt     DateTime?
  error         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([orgId, createdAt])
  @@index([status, createdAt])
}

model StripeWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  type        String
  processedAt DateTime @default(now())
}

model User {
  id         String        @id @default(cuid())
  supabaseId String        @unique
  email      String        @unique
  name       String?
  orgId      String?
  org        Organization? @relation(fields: [orgId], references: [id])
  role       String        @default("owner") // 'owner' | 'member'
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Integration {
  id                   String       @id @default(cuid())
  orgId                String
  org                  Organization @relation(fields: [orgId], references: [id])
  provider             String // 'unipile' | 'smartlead' | 'stripe'
  encryptedCredentials String // AES-256-GCM encrypted
  status               String       @default("pending") // 'pending' | 'active' | 'expired' | 'error'
  lastVerifiedAt       DateTime?
  metadata             Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([orgId, provider])
}

model Strategy {
  id               String       @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id])
  icpDefinition    Json
  positioning      Json
  channels         Json
  messagingAngles  Json
  creativeAssets   Json
  executionPlan    Json         @default("[]")
  completedSteps   Int[]
  audienceSegments Json?
  channelPlan      Json?
  contentApproach  Json?
  expectedOutcome  Json?
  reachSequence    Json?
  statHighlights   Json?
  approvedAt       DateTime?
  logoUrl          String?
  campaignType     String?
  videoConfig      Json?
  version          Int          @default(1)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([orgId])
}

model Campaign {
  id               String                   @id @default(cuid())
  orgId            String
  org              Organization             @relation(fields: [orgId], references: [id])
  strategyId       String?
  /// Legacy LinkedIn sender mirror. Prefer CampaignChannelAccount for multi-channel.
  socialAccountId  String?
  senderAccount    SocialAccount?           @relation("CampaignSender", fields: [socialAccountId], references: [id], onDelete: SetNull)
  name             String
  status           String                   @default("draft") // 'draft' | 'review' | 'active' | 'paused' | 'completed'
  suspensionReason String? // null | 'billing'
  channels         String[]
  sequence         Json // SequenceStep[]
  aiConfig         Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  leads            CampaignLead[]
  messages         Message[]
  videoAssets      VideoAsset[]
  videoTemplates   CampaignVideoTemplate[]
  channelAccounts  CampaignChannelAccount[]

  @@index([orgId, status])
  @@index([orgId, suspensionReason])
  @@index([orgId, socialAccountId])
}

/// One connected Unipile sender per outreach channel on a campaign.
model CampaignChannelAccount {
  id              String        @id @default(cuid())
  campaignId      String
  campaign        Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel         String // 'linkedin' | 'whatsapp' | 'facebook' | 'instagram' | 'email'
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([campaignId, channel])
  @@index([socialAccountId])
}

model Lead {
  id                  String         @id @default(cuid())
  orgId               String
  org                 Organization   @relation(fields: [orgId], references: [id])
  source              String // 'csv' | 'manual' | 'apify' | 'sales_navigator'
  email               String?
  linkedinUrl         String?
  phone               String?
  avatarUrl           String?
  firstName           String
  lastName            String
  company             String
  title               String
  industry            String?
  videoAssets         VideoAsset[]
  companySize         String?
  location            String?
  enrichmentData      Json?
  providerLinkedinId  String?
  providerWhatsappId  String?
  providerFacebookId  String?
  providerInstagramId String?
  status              String         @default("new") // 'new' | 'contacted' | 'connected' | 'replied' | 'meeting' | 'converted' | 'lost' | 'skipped'
  reviewStatus        String         @default("pending") // 'pending' | 'approved' | 'excluded'
  reviewedAt          DateTime?
  pipelineStage       String?
  tags                String[]
  notes               Json[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  campaigns           CampaignLead[]
  messages            Message[]

  @@index([orgId, status])
  @@index([orgId, reviewStatus])
  @@index([orgId, createdAt])
  @@index([orgId, updatedAt])
  @@index([orgId, email])
  @@index([orgId, phone])
}

model CampaignLead {
  id                     String                  @id @default(cuid())
  campaignId             String
  campaign               Campaign                @relation(fields: [campaignId], references: [id])
  leadId                 String
  lead                   Lead                    @relation(fields: [leadId], references: [id])
  currentStep            Int                     @default(0)
  /// Legacy LinkedIn chat id. Prefer providerChatId for new multi-channel code.
  linkedinChatId         String?                 @unique
  /// Unipile chat/thread id for messaging channels (LinkedIn, WhatsApp, Messenger, Instagram).
  providerChatId         String?                 @unique
  /// Soft key for email reply matching (accountId:normalizedEmail).
  emailThreadKey         String?
  status                 String                  @default("active") // 'active' | 'completed' | 'replied' | 'skipped'
  createdAt              DateTime                @default(now())
  deliveryAttempts       DeliveryAttempt[]
  manualDeliveryAttempts ManualDeliveryAttempt[]

  @@unique([campaignId, leadId])
  @@index([emailThreadKey])
  @@index([campaignId, status, createdAt])
}

model DeliveryAttempt {
  id             String       @id @default(cuid())
  campaignLeadId String
  campaignLead   CampaignLead @relation(fields: [campaignLeadId], references: [id], onDelete: Cascade)
  stepIndex      Int
  state          String       @default("reserved") // 'reserved' | 'recovering' | 'sent' | 'unknown' | 'failed'
  // Reserved for provider idempotency. Unipile currently documents no idempotency
  // parameter for invite/chat/message sends, so a post-send crash remains unknown
  // until provider-positive recovery succeeds or an operator reviews it.
  idempotencyKey String?      @unique
  providerRef    String?
  reservedAt     DateTime     @default(now())
  sentAt         DateTime?
  updatedAt      DateTime     @updatedAt

  @@unique([campaignLeadId, stepIndex])
  @@index([state, reservedAt])
}

model Message {
  id                    String                 @id @default(cuid())
  campaignId            String
  campaign              Campaign               @relation(fields: [campaignId], references: [id])
  leadId                String
  lead                  Lead                   @relation(fields: [leadId], references: [id])
  orgId                 String
  channel               String // 'linkedin' | 'whatsapp' | 'instagram' | 'facebook' | 'email'
  content               Json // { type, subject?, body?, message?, text? }
  direction             String                 @default("outbound") // 'inbound' | 'outbound'
  origin                String                 @default("automation") // 'automation' | 'operator'
  status                String                 @default("draft") // 'draft' | 'queued' | 'sent' | 'delivered' | 'opened' | 'replied' | 'bounced' | 'skipped'
  externalId            String?
  stepIndex             Int
  sentAt                DateTime?
  approvedBy            String?
  approvedAt            DateTime?
  readAt                DateTime?
  handledAt             DateTime?
  idempotencyKey        String?                @unique
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  manualDeliveryAttempt ManualDeliveryAttempt?

  @@index([orgId, campaignId])
  @@index([externalId])
  @@index([status])
  @@index([orgId, direction, readAt])
  @@index([orgId, createdAt])
  @@index([orgId, direction, createdAt])
  @@index([campaignId, createdAt])
}

model ManualDeliveryAttempt {
  id             String       @id @default(cuid())
  messageId      String       @unique
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  campaignLeadId String
  campaignLead   CampaignLead @relation(fields: [campaignLeadId], references: [id], onDelete: Cascade)
  state          String       @default("reserved") // 'reserved' | 'sent' | 'unknown' | 'failed'
  providerRef    String?
  reservedAt     DateTime     @default(now())
  sentAt         DateTime?
  updatedAt      DateTime     @updatedAt

  @@index([campaignLeadId, state])
  @@index([state, reservedAt])
}

model AnalyticsEvent {
  id             String   @id @default(cuid())
  orgId          String
  campaignId     String?
  messageId      String?
  leadId         String?
  eventType      String // 'sent' | 'delivered' | 'opened' | 'replied' | 'bounced' | 'converted' | 'skipped'
  channel        String
  metadata       Json?
  webhookEventId String?  @unique
  timestamp      DateTime @default(now())

  @@index([orgId, campaignId])
  @@index([orgId, timestamp])
}

model SocialAccount {
  id                      String                   @id @default(cuid())
  orgId                   String
  org                     Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  platform                String // 'linkedin' | 'whatsapp' | 'instagram' | 'facebook' | 'email'
  platformUserId          String
  unipileId               String? // Unipile's internal account ID
  accountName             String
  avatarUrl               String?
  status                  String                   @default("active") // 'active' | 'disconnected' | 'error' | 'reconnecting'
  metadata                Json?
  senderCampaigns         Campaign[]               @relation("CampaignSender")
  campaignChannelAccounts CampaignChannelAccount[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@unique([orgId, platform, platformUserId])
  @@index([orgId])
}

model VideoAsset {
  id                String                 @id @default(cuid())
  orgId             String
  org               Organization           @relation(fields: [orgId], references: [id])
  campaignId        String?
  campaign          Campaign?              @relation(fields: [campaignId], references: [id])
  leadId            String?
  lead              Lead?                  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  templateId        String?
  template          CampaignVideoTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  pipeline          String                 @default("standard") // 'standard' | 'personalized'
  status            String                 @default("pending") // 'pending' | 'generating' | 'ready' | 'approved' | 'rejected' | 'failed'
  seedImageUrl      String?
  videoUrl          String? // Cloudflare R2 URL
  thumbnailUrl      String?
  generation        Int                    @default(1) // 1, 2, or 3 (parallel variants)
  selectedTone      String?
  criticScore       Int?
  needsReview       Boolean                @default(false)
  veoOperationId    String?                @unique
  veoOperationState String? // 'submitting' | 'active' | 'recovering' | 'completed' | 'failed' | 'unknown'
  veoSubmitLeaseAt  DateTime? // Submission, active-poll, or recovery lease.
  approvedBy        String?
  approvedAt        DateTime?
  renderManifest    Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([templateId, leadId])
  @@index([orgId, status])
  @@index([orgId, updatedAt])
  @@index([campaignId])
  @@index([leadId])
  @@index([templateId])
  @@index([campaignId, leadId])
  @@index([veoOperationState, veoSubmitLeaseAt])
}

model CampaignVideoTemplate {
  id                 String       @id @default(cuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaignId         String
  campaign           Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  version            Int          @default(1)
  status             String       @default("pending") // 'pending' | 'generating' | 'ready' | 'failed'
  seedImageUrl       String?
  masterVideoUrl     String?
  sharedNarrationUrl String?
  imagePrompt        String?
  videoPrompt        String?
  sharedNarration    String?
  logoUrl            String?
  selectedTone       String?
  voice              String
  criticScore        Int?
  needsReview        Boolean      @default(false)
  veoOperationId     String?      @unique
  veoOperationState  String? // 'submitting' | 'active' | 'completed' | 'failed'
  veoSubmitLeaseAt   DateTime?
  renderManifest     Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  videoAssets        VideoAsset[]

  @@unique([campaignId, version])
  @@index([orgId, status])
  @@index([campaignId, status])
  @@index([veoOperationState, veoSubmitLeaseAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  userId     String?
  action     String // 'credential.access' | 'campaign.launch' | 'video.generate'
  resource   String // 'Integration' | 'Campaign' | 'VideoAsset'
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([orgId, action])
  @@index([orgId, createdAt])
}

model PipelineRun {
  id        String   @id @default(cuid())
  orgId     String
  agentName String // 'video-prompt' | 'strategy' | 'messaging'
  input     Json
  output    Json?
  status    String   @default("running") // 'running' | 'completed' | 'failed'
  attempts  Int      @default(1)
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, agentName])
  @@index([orgId, status])
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
