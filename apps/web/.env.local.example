# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public support contact. Keep this equal to the API service's SUPPORT_EMAIL.
NEXT_PUBLIC_SUPPORT_EMAIL=support@leadreacher.com

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cloudflare Turnstile public site key. Leave empty for local development when
# CAPTCHA is disabled in the development Supabase project.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
